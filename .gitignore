# Dependencies
node_modules/

# Astro build output
dist/
.astro/

# Environment
.env
.env.*

# Editor and OS
.DS_Store
*.log

# Local development artifacts. Holds the product record, the design system and
# tooling output; none of it is part of the site, so none of it belongs here.
.impeccable/

# Screenshot helpers that need a browser installed ad hoc. scripts/og-card.mjs
# is tracked because it regenerates a published asset; these two are not.
scripts/shoot.mjs
scripts/measure.mjs

# The product record and the design system. Kept at the project root so the
# design tooling can find them, and deliberately not published.
PRODUCT.md
DESIGN.md
