---
// Authored icon, one stroke weight, matching the site's geometry.
interface Props { size?: number }
const { size = 20 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  <path d="M21 3 3 10.5l7 2.5 2.5 7L21 3Z" />
  <path d="M21 3 10 13" />
</svg>
