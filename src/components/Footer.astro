---
import { site, absoluteUrl } from "../config";

interface Props {
  lang?: "de" | "en";
}
const { lang = "de" } = Astro.props;
const year = new Date().getFullYear();

const sections =
  lang === "en"
    ? [
        {
          title: "Pages",
          links: [
            { href: "/en/services/", label: "Services" },
            { href: "/en/pricing/", label: "Pricing" },
            { href: "/en/contact/", label: "Contact" },
            { href: "/", label: "Deutsch" },
          ],
        },
        {
          title: "German only",
          links: [
            { href: "/wissen/", label: "Guides" },
            { href: "/referenzen/", label: "Work" },
            { href: "/ueber/", label: "About" },
          ],
        },
        {
          title: "Legal",
          links: [
            { href: "/impressum/", label: "Impressum" },
            { href: "/datenschutz/", label: "Privacy" },
            { href: absoluteUrl("/llms.txt"), label: "llms.txt" },
          ],
        },
      ]
    : [
        {
          title: "Kontakt",
          links: [
            { href: site.telegram, label: `Telegram ${site.telegramLabel}` },
            { href: site.proof[0].href, label: "astro-seo-toolkit auf GitHub" },
          ],
        },
        {
          title: "Seiten",
          links: [
            { href: "/leistungen/", label: "Leistungen" },
            { href: "/preise/", label: "Preise" },
            { href: "/referenzen/", label: "Referenzen" },
            { href: "/wissen/", label: "Wissen" },
            { href: "/ueber/", label: "Über" },
            { href: "/en/", label: "English" },
          ],
        },
        {
          title: "Rechtliches",
          links: [
            { href: "/impressum/", label: "Impressum" },
            { href: "/datenschutz/", label: "Datenschutz" },
            { href: absoluteUrl("/llms.txt"), label: "llms.txt" },
          ],
        },
      ];
---
<footer class="footer">
  <div class="wrap footer__grid">
    {
      sections.map((section) => (
        <div>
          <h3>{section.title}</h3>
          <ul>
            {section.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="wrap footer__base">
    <p>© {year} {site.name} · {site.serviceArea} · {site.languages}</p>
  </div>
</footer>
