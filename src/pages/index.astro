---
import Base from "../layouts/Base.astro";
import IconTelegram from "../components/IconTelegram.astro";
import Mechanism from "../components/Mechanism.astro";
import { getCollection } from "astro:content";
import { site, prices, bundle, fx } from "../config";
import { organization, faqPage, service } from "../lib/schema";

const articles = (await getCollection("wissen")).sort((a, b) => a.data.title.localeCompare(b.data.title));

const faqs = [
  {
    q: "Was kostet eine Website bei Ihnen?",
    a: "3’200 Franken beziehungsweise 3’450 Euro für fünf bis acht Seiten mit einer eigenen Seite je Leistung. Der Preis steht samt Marktvergleich auf der Preisseite — Freelancer liegen im Schnitt bei 2’100 Franken, Kleinagenturen bei 6’800.",
  },
  {
    q: "Was passiert bei einer Messung?",
    a: "Ich prüfe, was Suchmaschinen und KI-Assistenten über Ihr Unternehmen finden: Ladezeit auf dem Handy, strukturierte Daten, Google-Unternehmensprofil, und ob Sie überhaupt in Antworten genannt werden. Sie bekommen Werte mit Datum, nicht eine Note.",
  },
  {
    q: "Arbeiten Sie nur mit Astro?",
    a: "Nein. Astro ist mein Werkzeug für neue Websites, weil dabei kein Wartungsaufwand entsteht. Bestehende Seiten auf WordPress oder einem Baukasten messe ich genauso und sage Ihnen, ob ein Umbau sinnvoll ist oder nicht.",
  },
  {
    q: "Wie läuft die Zusammenarbeit ab?",
    a: "Alles über Telegram. Sie schreiben, ich antworte innerhalb eines Werktags. Es gibt kein Formular, kein Portal und kein Ticket-System.",
  },
  {
    q: "Warum steht hier kein Ort und keine Referenz?",
    a: "Ich arbeite für Kunden in Deutschland, Österreich und der Schweiz — über das Netz, nicht über die Nachbarschaft. Kundenstimmen veröffentliche ich nicht ohne Einwilligung. Was ich stattdessen veröffentliche, ist der Code: Werkzeuge auf npm, offen und nachlesbar.",
  },
  {
    q: "Helfen llms.txt und strukturierte Daten bei Google?",
    a: "llms.txt hilft bei Google nicht. Google liest die Datei nicht. Sie wirkt auf Assistenten wie ChatGPT, Claude und Perplexity. Für Google zählen Sitemap, Indexierung und zitierfähige Inhalte. Beides kommt hier vor, und ich sage dazu, welcher Teil was bewirkt.",
  },
];

const signals = [
  { label: "Ladezeit mobil, LCP", before: "5,9 s", after: "1,2 s" },
  { label: "Strukturierte Daten", before: "keine", after: "gültig" },
  { label: "Nennung in KI-Antworten, 5 Abfragen", before: "0 von 5", after: "2 von 5" },
  { label: "Google-Unternehmensprofil", before: "nicht beansprucht", after: "vollständig" },
];

const schemas = [
  organization(),
  ...prices.map((p) =>
    service({ name: p.name, description: p.summary, path: `/leistungen/${p.slug}/`, price: p.chf }),
  ),
  faqPage(faqs),
];

const serviceTapes = [
  { label: "Websites", href: "/leistungen/website/" },
  { label: "Lokale Sichtbarkeit", href: "/leistungen/lokale-sichtbarkeit/" },
  { label: "KI-Sichtbarkeit", href: "/leistungen/ki-sichtbarkeit/" },
];
---
<Base
  title="Website & SEO für Handwerk und lokale Betriebe"
  description="Websites und SEO für Handwerk, Praxen und lokale Betriebe in Deutschland, Österreich und der Schweiz. Festpreise, gemessene Werte, offengelegter Code."
  schemas={schemas}
  hreflang
>
  <!-- FIRST VIEWPORT: the tape at full strength, two lines, nothing centred. -->
  <section class="hero">
    <div class="hero__head">
      <h1 class="hero__stack">
        <span class="tape tape--display tape--run settle" style="--rot:-1.4deg">Websites und SEO,</span>
        <span class="tape tape--display tape--run settle settle--2" style="--rot:0.45deg">
          {" die gefunden werden"}
        </span>
      </h1>
    </div>

    <div class="wrap">
      <div class="hero__body">
        <div>
          <div class="hero__services">
            {
              serviceTapes.map((s, i) => (
                <a
                  class={`tape tape--md settle settle--${i + 3}`}
                  href={s.href}
                  style={`--rot:${[-0.9, 0.5, -0.4][i]}deg`}
                >
                  {s.label}
                </a>
              ))
            }
          </div>

          <div class="hero__action">
            <a class="tape tape--lg tape--signal settle settle--4" href={site.telegram} rel="me" style="--rot:-0.6deg">
              <span style="display:inline-flex;align-items:center;gap:0.55em">
                <IconTelegram size={22} />
                Messung anfragen
              </span>
            </a>
            <span style="font-size:var(--t--1);color:var(--ink-2)">Nichts installieren, nichts ausfüllen.</span>
          </div>
        </div>

        <div>
          <p class="hero__claim">
            Für Handwerk, Praxen und lokale Betriebe im deutschsprachigen Raum. Eine Website,
            die schnell lädt, ist die Grundlage — gefunden werden heißt danach: Sitemap,
            strukturierte Daten, zitierfähige Antworten. Und weil Suchanfragen zunehmend von
            Assistenten beantwortet werden, gehört auch das gemessen.
          </p>
        </div>
      </div>

      <div class="hero__foot">
        <div class="year">{new Date().getFullYear()}</div>
        <p class="hero__area">
          {site.serviceArea}<br />{site.languages}
        </p>
      </div>
    </div>
  </section>

  <!-- Shown, not told: the mechanism, as a schematic. -->
  <section class="section">
    <div class="wrap">
      <h2 class="tape tape--lg" style="--rot:-0.8deg">Wie eine Frage zu einer Antwort wird</h2>
      <p class="lede" style="margin-top:1.5rem">
        Ob Google oder ein Assistent: beide lesen dasselbe. Was maschinenlesbar auf der Seite
        steht, entscheidet, ob Ihr Betrieb in der Antwort vorkommt.
      </p>
      <div class="rise" style="margin-top:2rem">
        <Mechanism />
      </div>
    </div>
  </section>

  <!-- The dark band: the page's second peak, and where the numbers live. -->
  <section class="band">
    <div class="wrap">
      <h2 class="tape tape--xl" style="--rot:0.5deg">Was gemessen wird</h2>
      <p class="lede" style="margin-top:1.5rem">
        Vier Werte, die darüber entscheiden, ob ein Betrieb gefunden wird. Alle vier sind
        messbar, keiner davon ist eine Meinung.
      </p>

      <ul class="measure" style="margin-top:1.5rem">
        {
          signals.map((s) => (
            <li>
              <span class="label">{s.label}</span>
              <span class="io">
                <s>{s.before}</s> → <b>{s.after}</b>
              </span>
            </li>
          ))
        }
      </ul>

      <p class="note" style="margin-top:1.75rem">
        Beispielwerte zur Veranschaulichung, keine Kundendaten. Eine echte Messung liefert
        Ihre Zahlen mit Datum und Quelle.
      </p>
    </div>
  </section>

  <!-- Proof: only real, verifiable artefacts. -->
  <section class="section">
    <div class="wrap">
      <h2 class="tape tape--lg" style="--rot:0.6deg">Was ich veröffentliche</h2>
      <p class="lede" style="margin-top:1.5rem">
        Ohne Kundenstimmen bleibt der Code die Referenz. Alles hier ist öffentlich und
        nachlesbar.
      </p>

      <ul class="pricerows" style="margin-top:1.75rem">
        {
          site.proof.map((item) => (
            <li style="grid-template-columns:minmax(0,0.8fr) minmax(0,1.2fr)">
              <div>
                <h3 style="font-size:var(--t-1)">
                  <a href={item.href}>{item.name}</a>
                </h3>
              </div>
              <p style="font-size:var(--t--1);color:var(--ink-2);max-width:52ch">{item.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Prices, each with the market figure it was placed against. -->
  <section class="section">
    <div class="wrap">
      <h2 class="tape tape--lg" style="--rot:-0.5deg">Preise</h2>
      <p class="lede" style="margin-top:1.5rem">
        Festpreise in Franken, mit Euro-Preis daneben. Umrechnung zum Kurs {fx.rate}, {fx.note}.
      </p>

      <ul class="pricerows" style="margin-top:1.75rem">
        {
          prices.map((p) => (
            <li>
              <div>
                <h3>
                  <a href={`/leistungen/${p.slug}/`}>{p.name}</a>
                </h3>
                <p>{p.summary}</p>
                <p style="font-size:var(--t--1);color:var(--ink-2);margin-top:0.4rem">
                  Markt: {p.against}
                </p>
              </div>
              <div class="price">
                <b>CHF {p.chf}</b>
                <span class="eur">EUR {p.eur}</span>
                <em>{p.unit}</em>
              </div>
            </li>
          ))
        }
        <li>
          <div>
            <h3>{bundle.name}</h3>
            <p>{bundle.note}</p>
          </div>
          <div class="price">
            <b>CHF {bundle.chf}</b>
            <span class="eur">EUR {bundle.eur}</span>
            <em>zusammen</em>
          </div>
        </li>
      </ul>

      <p style="margin-top:1.5rem">
        <a class="tape tape--md" href="/preise/" style="--rot:0.4deg">Marktvergleich ansehen</a>
      </p>
    </div>
  </section>

  <!-- The honest limits, at display scale. This is the differentiator. -->
  <section class="section">
    <div class="wrap">
      <h2 class="tape tape--xl" style="--rot:-0.7deg">Was nicht wirkt</h2>
      <div class="prose" style="margin-top:1.75rem">
        <p>
          <strong>llms.txt bringt nichts bei Google.</strong> Google liest die Datei nicht.
          Sie wirkt auf Assistenten. Wer Ihnen llms.txt als Ranking-Hebel verkauft, verkauft
          Ihnen eine Datei und nennt es Strategie.
        </p>
        <p>
          <strong>Keine Garantie auf Nennung.</strong> KI-Antworten sind nicht
          deterministisch. Ich kann die Grundlagen herstellen — zitierfähige Absätze,
          strukturierte Angaben, saubere Indexierung — aber ich kann nicht versprechen, dass
          ein Modell Sie morgen nennt. Wer das verspricht, hat es nicht gemessen.
        </p>
        <p>
          <strong>Keine Zahlen aus fremden Projekten.</strong> Ich veröffentliche keine
          Prozentwerte aus Kundenarbeit und keine Bewertungen ohne Einwilligung. Die einzigen
          Zahlen auf dieser Seite sind Marktdaten mit Quelle, und Beispielwerte, die als
          solche gekennzeichnet sind.
        </p>
      </div>
    </div>
  </section>

  <!-- Internal linking into the articles. -->
  <section class="section">
    <div class="wrap">
      <h2 class="tape tape--lg" style="--rot:0.4deg">Zum Nachlesen</h2>
      <ul class="nextread" style="margin-top:1.5rem">
        {
          articles.map((a) => (
            <li>
              <a href={`/wissen/${a.id}/`}>{a.data.title}</a>
              <span>{a.data.description}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="tape tape--lg" style="--rot:-0.5deg">Häufige Fragen</h2>
      <div class="faq" style="margin-top:1.75rem">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p style="margin:0">
        <a class="tape tape--xl tape--signal" href={site.telegram} rel="me" style="--rot:-0.5deg">
          Auf Telegram fragen
        </a>
      </p>
      <p style="margin-top:1.5rem;font-size:var(--t-0);color:color-mix(in srgb, var(--emboss) 74%, var(--tape))">
        Antwort innerhalb eines Werktags. Kein Formular, kein Portal, keine Ticketnummer.
      </p>
      <p style="margin-top:0.75rem;font-size:var(--t--1);color:color-mix(in srgb, var(--emboss) 62%, var(--tape))">
        {site.serviceArea} · {site.languages}
      </p>
    </div>
  </section>
</Base>
