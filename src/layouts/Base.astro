---
import { site, absoluteUrl } from "../config";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  schemas?: unknown[];
  noindex?: boolean;
  lang?: "de" | "en";
  /** Only set on the / ↔ /en/ pair. */
  hreflang?: boolean;
}

const {
  title,
  description = site.claim,
  schemas = [],
  noindex = false,
  lang = "de",
  hreflang = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;

const navItems =
  lang === "en"
    ? [
        { href: "/en/services/", label: "Services" },
        { href: "/en/pricing/", label: "Pricing" },
        { href: "/en/contact/", label: "Contact", secondary: true },
      ]
    : [
        { href: "/leistungen/", label: "Leistungen" },
        { href: "/preise/", label: "Preise" },
        { href: "/referenzen/", label: "Referenzen", secondary: true },
        { href: "/wissen/", label: "Wissen", secondary: true },
        { href: "/kontakt/", label: "Kontakt" },
      ];

const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      hreflang && (
        <>
          <link rel="alternate" hreflang="de" href={`${site.url}/`} />
          <link rel="alternate" hreflang="en" href={`${site.url}/en/`} />
          <link rel="alternate" hreflang="x-default" href={`${site.url}/`} />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "en" ? "en" : "de"} />
    <meta property="og:image" content={absoluteUrl("/og-card.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.headline} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={absoluteUrl("/og-card.png")} />
    <meta name="theme-color" content="#e7e5df" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ArchivoNarrow-var.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Archivo-var.woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt springen</a>

    <header class="header">
      <div class="wrap header__inner">
        <a class="brand" href={lang === "en" ? "/en/" : "/"}>{site.name}</a>
        <nav class="nav" aria-label={lang === "en" ? "Main navigation" : "Hauptnavigation"}>
          {
            navItems.map((item) => (
              <a
                href={item.href}
                data-secondary={item.secondary ? "" : undefined}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a class="tape tape--sm" href={site.telegram} rel="me" style="--rot:-0.7deg">
            <span class="nav__wide">{lang === "en" ? "Ask on Telegram" : "Auf Telegram fragen"}</span>
            <span class="nav__narrow">{lang === "en" ? "Telegram" : "Telegram"}</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />
    <JsonLd schemas={schemas} />
  </body>
</html>
